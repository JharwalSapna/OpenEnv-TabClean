# Copy this to `.env` and fill values locally (never commit `.env`).

API_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct
HF_TOKEN=hf_your_token_here

TAB_CLEAN_BASE_URL=http://localhost:8000
TAB_CLEAN_TASK=easy_schemafix
TAB_CLEAN_SEED=0

MAX_STEPS=10
TEMPERATURE=0.2
MAX_TOKENS=250
SUCCESS_SCORE_THRESHOLD=0.95

